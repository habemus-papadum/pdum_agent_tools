{
  "name": "@habemus-papadum/orchestrator-app",
  "private": true,
  "type": "module",
  "aiui": {
    "scaffold": true,
    "sitePage": {
      "title": "Agent tools",
      "desc": "Multi-provider agent orchestration",
      "order": 1000,
      "card": "./card"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page.tsx",
    "./card": "./src/card.tsx"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@habemus-papadum/agent-core": "catalog:",
    "@habemus-papadum/orchestrator-client": "catalog:",
    "@habemus-papadum/aiui-prompts": "catalog:",
    "@habemus-papadum/aiui-design": "catalog:",
    "@habemus-papadum/aiui-source-processor": "catalog:",
    "@habemus-papadum/aiui-viz": "catalog:",
