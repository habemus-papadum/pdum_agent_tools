    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
