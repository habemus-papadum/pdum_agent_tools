{
  "name": "@habemus-papadum/agent-history",
  "version": "0.1.0+dev",
  "description": "Ingest Codex and Claude Code session history into DuckDB, check invariants, run analysis questions and render one session in the terminal.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/habemus-papadum/pdum_agent_tools.git",
    "directory": "typescript/packages/agent-history"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./analysis": "./src/analysis.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "agent-history": "./dist/cli.js"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./analysis": {
        "types": "./dist/analysis.d.ts",
        "import": "./dist/analysis.js",
        "default": "./dist/analysis.js"
      }
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
