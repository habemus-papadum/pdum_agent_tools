+use super::browser_origin_allowed;
+use super::parse_browser_origins;
+use axum::http::HeaderMap;
+use axum::http::HeaderValue;
+use axum::http::header::ORIGIN;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn browser_origin_default_preserves_native_clients_and_rejects_browsers() {
+    let mut headers = HeaderMap::new();
+    assert!(browser_origin_allowed(&headers, &[]));
+    headers.insert(ORIGIN, HeaderValue::from_static("http://127.0.0.1:5173"));
+    assert!(!browser_origin_allowed(&headers, &[]));
+}
+
+#[test]
+fn browser_origin_accepts_only_exact_allowlisted_origins() {
+    let allowed = vec!["http://127.0.0.1:5173".to_string()];
+    for (origin, expected) in [
+        ("http://127.0.0.1:5173", true),
+        ("http://127.0.0.1:5174", false),
+        ("https://127.0.0.1:5173", false),
+        ("http://localhost:5173", false),
+        ("http://127.0.0.1:5173.attacker.test", false),
+        ("null", false),
+        ("*", false),
+        ("http://127.0.0.1:5173 http://attacker.test", false),
+        ("http://127.0.0.1:5173,http://attacker.test", false),
+    ] {
+        let mut headers = HeaderMap::new();
+        headers.insert(ORIGIN, HeaderValue::from_str(origin).expect("header value"));
+        assert_eq!(browser_origin_allowed(&headers, &allowed), expected);
+    }
+}
+
+#[test]
+fn browser_origin_rejects_duplicate_headers_even_when_both_are_allowed() {
+    let allowed = vec!["http://127.0.0.1:5173".to_string()];
+    let mut headers = HeaderMap::new();
+    headers.append(ORIGIN, HeaderValue::from_static("http://127.0.0.1:5173"));
+    headers.append(ORIGIN, HeaderValue::from_static("http://127.0.0.1:5173"));
+    assert!(!browser_origin_allowed(&headers, &allowed));
+}
+
+#[test]
+fn browser_origin_parses_multiple_exact_origins() {
+    assert_eq!(
+        parse_browser_origins(
+            r#"["http://127.0.0.1:5173","https://trusted.example"]"#,
+            "127.0.0.1:0".parse().expect("socket address"),
+        )
+        .expect("origin allowlist"),
+        vec![
+            "http://127.0.0.1:5173".to_string(),
+            "https://trusted.example".to_string()
+        ]
+    );
+}
+
+#[test]
+fn browser_origin_rejects_invalid_allowlists() {
+    for value in [
+        "*",
+        "null",
+        r#"["*"]"#,
+        r#"["https://*.example"]"#,
+        r#"["null"]"#,
+        r#"["file:///tmp/page.html"]"#,
+        r#"["http://127.0.0.1:5173/"]"#,
+        r#"["https://trusted.example/path"]"#,
+        r#"["https://trusted.example?query"]"#,
+        r#"["https://trusted.example#fragment"]"#,
+        r#"["https://user:pass@trusted.example"]"#,
+        r#"["https://trusted.example:443"]"#,
+        r#"["https://trusted.example",null]"#,
+    ] {
+        assert!(
+            parse_browser_origins(value, "127.0.0.1:0".parse().expect("socket address")).is_err()
+        );
+    }
+}
+
+#[test]
+fn browser_origin_rejects_non_loopback_opt_in() {
+    assert!(
+        parse_browser_origins(
+            r#"["https://trusted.example"]"#,
+            "0.0.0.0:8080".parse().expect("socket address"),
+        )
+        .is_err()
+    );
+}
