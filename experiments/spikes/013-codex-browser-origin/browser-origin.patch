+fn parse_browser_origins(value: &str, bind_address: SocketAddr) -> IoResult<Vec<String>> {
+    if !bind_address.ip().is_loopback() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "spike browser origins require a loopback listener",
+        ));
+    }
+    let origins: Vec<String> = serde_json::from_str(value).map_err(|_| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "spike browser origins must be a JSON array of exact HTTP(S) origins",
+        )
+    })?;
+    for origin in &origins {
+        let valid = url::Url::parse(origin).is_ok_and(|parsed| {
+            matches!(parsed.scheme(), "http" | "https")
+                && !origin.contains('*')
+                && parsed.origin().ascii_serialization() == *origin
+        });
+        if !valid {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "spike browser origins must be canonical HTTP(S) origins without paths or wildcards",
+            ));
+        }
+    }
+    Ok(origins)
+}
+
+fn load_browser_origins(bind_address: SocketAddr) -> IoResult<Vec<String>> {
+    match std::env::var(SPIKE_BROWSER_ORIGINS_ENV) {
+        Ok(value) => parse_browser_origins(&value, bind_address),
+        Err(std::env::VarError::NotPresent) => Ok(Vec::new()),
+        Err(std::env::VarError::NotUnicode(_)) => Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "spike browser origins must contain valid Unicode",
+        )),
+    }
+}
+
+fn browser_origin_allowed(headers: &HeaderMap, allowed_origins: &[String]) -> bool {
+    let mut origins = headers.get_all(ORIGIN).iter();
+    let Some(origin) = origins.next() else {
+        return true;
+    };
+    origins.next().is_none()
+        && origin
+            .to_str()
+            .is_ok_and(|origin| allowed_origins.iter().any(|allowed| allowed == origin))
+}
 
