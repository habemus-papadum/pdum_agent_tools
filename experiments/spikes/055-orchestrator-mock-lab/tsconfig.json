{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "../053-orchestrator-overview/**/*.ts",
    "../053-orchestrator-overview/**/*.tsx",
    "../054-orchestrator-session/**/*.ts",
    "../054-orchestrator-session/**/*.tsx",
    "../059-historical-viewer/src/**/*.ts",
    "../059-historical-viewer/src/**/*.tsx",
    "../060-authentication-flows/src/**/*.ts",
    "../060-authentication-flows/src/**/*.tsx",
    "../061-ingestion-statistics/src/**/*.ts",
    "../061-ingestion-statistics/src/**/*.tsx",
    "../062-launcher-connections/src/**/*.ts",
    "../062-launcher-connections/src/**/*.tsx",
    "../063-profile-workbench/src/**/*.ts",
    "../063-profile-workbench/src/**/*.tsx",
    "../067-live-session-workspace/src/**/*.ts",
    "../067-live-session-workspace/src/**/*.tsx"
  ]
}
